{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteStateFileOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::*-terraform/nwarila-platform/secure-wazuh/*.tfstate"
    },
    {
      "Sid": "ManageS3LockfileOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::*-terraform/nwarila-platform/secure-wazuh/*.tfstate.tflock"
    },
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::*-terraform"
    },
    {
      "Sid": "DenyDeleteStateFile",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::*-terraform/nwarila-platform/secure-wazuh/*.tfstate"
    },
    {
      "Sid": "DenyUnencryptedPuts",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::*-terraform/nwarila-platform/secure-wazuh/*",
      "Condition": {
        "StringNotEquals": {
          "s3:x-amz-server-side-encryption": "AES256"
        }
      }
    },
    {
      "Sid": "DenyPutsWithoutEncryptionHeader",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::*-terraform/nwarila-platform/secure-wazuh/*",
      "Condition": {
        "Null": {
          "s3:x-amz-server-side-encryption": "true"
        }
      }
    },
    {
      "Sid": "ReadWazuhArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::*-ansible/functions/wazuh/*",
        "arn:aws:s3:::*-ansible/applications/wazuh-agent/*"
      ]
    },
    {
      "Sid": "ListWazuhArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::*-ansible",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "functions/wazuh/*",
            "applications/wazuh-agent/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadArtifactBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::*-ansible"
    }
  ]
}
