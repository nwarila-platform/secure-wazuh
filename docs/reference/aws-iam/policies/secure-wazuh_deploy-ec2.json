{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GetConsoleOutputForOurInstances",
      "Effect": "Allow",
      "Action": "ec2:GetConsoleOutput",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "RunInstancesTypeLocked",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "ec2:InstanceType": [
            "m6i.xlarge",
            "t3.medium"
          ],
          "ec2:Tenancy": "default",
          "ec2:MetadataHttpTokens": "required",
          "aws:RequestTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "RunInstancesVolumeCapped",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:us-east-1:*:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:VolumeType": "gp3"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "100"
        },
        "NumericLessThanEqualsIfExists": {
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        }
      }
    },
    {
      "Sid": "RunInstancesSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:us-east-1:*:network-interface/*",
        "arn:aws:ec2:us-east-1:*:subnet/*",
        "arn:aws:ec2:us-east-1:*:security-group/*",
        "arn:aws:ec2:us-east-1:*:key-pair/*",
        "arn:aws:ec2:us-east-1:*:image/*",
        "arn:aws:ec2:us-east-1::image/*"
      ]
    },
    {
      "Sid": "TagOnlyAtCreateTime",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:*:instance/*",
        "arn:aws:ec2:us-east-1:*:volume/*",
        "arn:aws:ec2:us-east-1:*:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateVolume",
            "CreateNetworkInterface"
          ],
          "aws:RequestTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "StampRepoIdentityTagOnRootVolumes",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:*:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/nwarila:management:repository-id": "1307854438",
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "DenyOverwriteForeignRepoIdentityTag",
      "Effect": "Deny",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:us-east-1:*:*/*",
      "Condition": {
        "Null": {
          "ec2:ResourceTag/nwarila:management:repository-id": "false"
        },
        "StringNotEquals": {
          "ec2:ResourceTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "DenySetWrongRepoIdentityTag",
      "Effect": "Deny",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:us-east-1:*:instance/*",
        "arn:aws:ec2:us-east-1:*:volume/*",
        "arn:aws:ec2:us-east-1:*:network-interface/*",
        "arn:aws:ec2:us-east-1:*:security-group/*",
        "arn:aws:ec2:us-east-1:*:security-group-rule/*"
      ],
      "Condition": {
        "Null": {
          "aws:RequestTag/nwarila:management:repository-id": "false"
        },
        "StringNotEquals": {
          "aws:RequestTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "DenyDeleteRepoIdentityTag",
      "Effect": "Deny",
      "Action": "ec2:DeleteTags",
      "Resource": "arn:aws:ec2:us-east-1:*:*/*",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "aws:TagKeys": "nwarila:management:repository-id"
        }
      }
    },
    {
      "Sid": "CreateDataVolumeCapped",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:aws:ec2:us-east-1:*:volume/*",
      "Condition": {
        "StringEquals": {
          "ec2:VolumeType": "gp3",
          "aws:RequestTag/nwarila:management:repository-id": "1307854438"
        },
        "NumericLessThanEquals": {
          "ec2:VolumeSize": "100"
        },
        "NumericLessThanEqualsIfExists": {
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        }
      }
    },
    {
      "Sid": "CreateEniWithRepoIdentity",
      "Effect": "Allow",
      "Action": "ec2:CreateNetworkInterface",
      "Resource": "arn:aws:ec2:us-east-1:*:network-interface/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "aws:RequestTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "UseEniSupportingLegs",
      "Effect": "Allow",
      "Action": "ec2:CreateNetworkInterface",
      "Resource": [
        "arn:aws:ec2:us-east-1:*:subnet/*",
        "arn:aws:ec2:us-east-1:*:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "LifecycleOnlyOnOurTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "ec2:DeleteNetworkInterface",
        "ec2:ModifyNetworkInterfaceAttribute",
        "ec2:DeleteTags"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/nwarila:management:repository-id": "1307854438"
        }
      }
    },
    {
      "Sid": "ModifyMetadataImdsV2Only",
      "Effect": "Allow",
      "Action": "ec2:ModifyInstanceMetadataOptions",
      "Resource": "arn:aws:ec2:us-east-1:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/nwarila:management:repository-id": "1307854438"
        },
        "StringEqualsIfExists": {
          "ec2:MetadataHttpTokens": "required"
        }
      }
    },
    {
      "Sid": "ModifyVolumeCapped",
      "Effect": "Allow",
      "Action": "ec2:ModifyVolume",
      "Resource": "arn:aws:ec2:us-east-1:*:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1",
          "ec2:ResourceTag/nwarila:management:repository-id": "1307854438"
        },
        "StringEqualsIfExists": {
          "ec2:VolumeType": "gp3"
        },
        "NumericLessThanEqualsIfExists": {
          "ec2:VolumeSize": "100",
          "ec2:VolumeIops": "3000",
          "ec2:VolumeThroughput": "125"
        }
      }
    }
  ]
}
