{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWazuhArtifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::<account-id>-ansible/functions/wazuh/*",
        "arn:aws:s3:::<account-id>-ansible/applications/wazuh-agent/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    },
    {
      "Sid": "ListWazuhArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<account-id>-ansible",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        },
        "StringLike": {
          "s3:prefix": [
            "functions/wazuh/*",
            "applications/wazuh-agent/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadArtifactBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::<account-id>-ansible",
      "Condition": {
        "StringEquals": {
          "aws:ResourceAccount": "<account-id>"
        }
      }
    }
  ]
}
