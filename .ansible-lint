---
# =============================================================================
# ansible-lint Configuration — secure-wazuh
# =============================================================================
# Applies the product conventions that remain valid after composition with
# ansible-framework. The generic loader expects the uppercase ENV play var and
# uses __dunder__ loop vars across the platform.
# =============================================================================

profile: safety

exclude_paths:
  - .git/
  - .github/
  # Shared roles and OS loaders are linted in ansible-framework. They remain
  # present for composed syntax resolution but are outside this product gate's
  # ownership; every product YAML path is supplied explicitly by the Makefile.
  - applications/linux_disk_manager/
  - applications/python3_pip/
  - applications/wazuh_agent/
  - operating_systems/

warn_list:
  # Paired #region/#endregion markers are stable navigational delimiters in role
  # loaders, task files, playbooks, and framework content.
  - yaml[comments]
  # The repository's yamllint policy permits rare lines through 160 columns as
  # warnings; ansible-lint reports the same policy without making it fatal.
  - yaml[line-length]

# Loop variables across this platform use the __dunder__ convention so the
# generic role loader's scratch facts (e.g., __overlay__) cannot be shadowed.
loop_var_prefix: ^__.*__$

# Platform-wide play-var convention. The canonical role loader at
# applications/<role>/tasks/main.yml requires it to be set (validated by an
# assert at INIT). ansible-lint's default var-naming pattern rejects uppercase,
# but ENV is intentional and matches flexnet, python3_pip, and tcnhq-kasm01.
var_naming_pattern: '^[A-Z][A-Z0-9_]*$|^[a-z_][a-z0-9_]*$'

offline: true

mock_roles: []
mock_modules: []
